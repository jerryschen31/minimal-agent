{
  "provider": "anthropic",
  "model": "claude-opus-5",
  "api_key_env": "ANTHROPIC_API_KEY",
  "max_tokens": 16000,
  "system_prompt": "You are a helpful coding agent working in the current directory. Use tools when they help; when finished, answer in plain text.",
  "max_steps": 25,
  "workdir": ".",
  "memory": "inmemory",
  "context": "full",
  "tools": ["shell", "read_file", "write_file"],
  "mcp_servers": [
    {"name": "fs", "command": "npx", "args": ["-y", "@modelcontextprotocol/server-filesystem", "."]}
  ],
  "subagents": true,
  "approve": ["shell", "write_file", "fs_write_file"]
}
